{
  "name": "coding-agent-development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspaces/coding-agent",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/coding-agent,type=bind",
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "runArgs": [
    "--cpus=2",
    "--memory=1536m",
    "--pids-limit=512"
  ],
  "postCreateCommand": ".devcontainer/setup.sh"
}
